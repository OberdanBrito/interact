MONGODB_URI=mongodb://interact:interact@localhost:27017/interact?authSource=admin
JWT_SECRET=interact-dev-secret
PORT=3002

# Tenant default (MT-19) — usado como fallback em dev e criado no seed.
DEFAULT_TENANT_SLUG=interna

# Canal SSE (I-07) — opcionais com defaults aplicados em src/routes/events.js e src/scheduler.js
# Intervalo do heartbeat/keep-alive do stream SSE (ms).
SSE_HEARTBEAT_MS=30000
# Intervalo do sweep que detecta comunicados expirados e emite post:expired (ms).
SSE_EXPIRED_SWEEP_MS=60000
