# Exemplo de env para a demo POC (sem segredos — copie para .env.poc e preencha).
# NODE_ENV NÃO é "production" aqui de propósito: sem isso o middleware de tenant
# (backend/src/middleware/tenant.js) não cai no fallback DEFAULT_TENANT_SLUG e a
# demo single-tenant quebraria em hostname de tailnet.

PORT=3003
MONGODB_URI=mongodb://interact:interact@localhost:27017/interact_poc?authSource=admin
DEFAULT_TENANT_SLUG=interna

# Segredos (gerar: JWT_SECRET=openssl rand -hex 32;
# ENCRYPTION_KEY=node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
JWT_SECRET=CHANGE-ME
ENCRYPTION_KEY=CHANGE-ME

# Hostname tailnet do POC (nome do serviço Tailscale "interact")
POC_HOST=obj.taild259e7.ts.net:8444